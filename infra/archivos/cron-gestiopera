# GestiOpera - Tareas programadas del servidor central
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Monitoreo de salud y seguridad cada 5 minutos
*/5 * * * *  root  gestiopera-monitor >/dev/null 2>&1

# Copia de seguridad diaria a la 01:30 (retencion configurable)
30 1 * * *   root  gestiopera-backup >/dev/null 2>&1

# Informe diario de eventos de seguridad a las 06:00
0 6 * * *    root  gestiopera-eventos --desde ayer --guardar >/dev/null 2>&1

# Informe semanal de auditoria general (lunes 07:00)
0 7 * * 1    root  gestiopera-auditoria --general --desde semana --guardar >/dev/null 2>&1

; GestiOpera - Zona directa @DOMINIO@
$TTL 3600
@       IN  SOA ns1.@DOMINIO@. admin.@DOMINIO@. (
            @SERIAL@ ; serial (AAMMDDhhmm)
            3600       ; refresh
            900        ; retry
            604800     ; expire
            300 )      ; TTL negativo
@               IN  NS      ns1.@DOMINIO@.
@               IN  A       @LAN_IP@
ns1             IN  A       @LAN_IP@
@SERVIDOR_HOST@        IN  A       @LAN_IP@
app             IN  CNAME   @SERVIDOR_HOST@
www             IN  CNAME   @SERVIDOR_HOST@
backup          IN  CNAME   @SERVIDOR_HOST@
pc-admin        IN  A       @CLIENTE_ADMIN_IP@

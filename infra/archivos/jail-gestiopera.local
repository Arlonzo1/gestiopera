# GestiOpera - Politica de fail2ban
[DEFAULT]
# Nunca bloquear el propio servidor ni el canal de gestion fuera de banda
ignoreip = 127.0.0.1/8 ::1 @CANAL_GESTION_IP@
bantime  = 15m
findtime = 10m
maxretry = 3
# Bloquea solo el puerto atacado (la app web sigue disponible)
banaction = iptables-multiport

[sshd]
# normal: cuenta usuarios inexistentes, claves erroneas y usuarios no permitidos;
# no castiga el rechazo de una llave publica ajena antes de pedir la contrasena
enabled = true
mode    = normal
port    = ssh
backend = systemd

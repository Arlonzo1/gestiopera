ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
POSTGRES_DB=billares_pos
POSTGRES_USER=billares_pos
POSTGRES_PASSWORD=change-this-strong-database-password
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=billares_pos;Username=billares_pos;Password=change-this-strong-database-password
Jwt__Issuer=BillaresPos
Jwt__Audience=BillaresPos.Api
Jwt__SigningKey=change-this-to-a-random-secret-at-least-32-characters
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# Firebase Admin SDK (production only)
Firebase__Enabled=false
Firebase__ProjectId=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json


# Meta WhatsApp Cloud API (production only)
WhatsApp__Enabled=false
WhatsApp__ApiVersion=v23.0
WhatsApp__PhoneNumberId=your-meta-phone-number-id
WhatsApp__AccessToken=use-secret-storage-never-source-control
# SMTP email notifications
Email__Enabled=false
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__EnableSsl=true
Email__SmtpUser=your-email@example.com
Email__SmtpPassword=use-an-app-password-never-source-control
Email__From=your-email@example.com
Email__SendReceipt=true

Database__ApplyMigrations=false
Cors__AllowedOrigins__0=https://your-frontend-domain.example

